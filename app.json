{
  "expo": {
    "name": "Coptic Vine Artists",
    "slug": "cv-artists",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/coptic-vine-artists-icon.png",
    "scheme": [
      "copticvine-artists",
      "copticvineartists"
    ],
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "icon": "./assets/images/coptic-vine-artists-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.copticvine.artists",
      "appleTeamId": "SVFMQZK524",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "copticvine-books",
          "copticvine-canon",
          "copticvine-music",
          "copticvine-learn"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#A24C2C",
        "foregroundImage": "./assets/images/coptic-vine-artists-android-foreground.png"
      },
      "package": "com.copticvine.artists"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/coptic-vine-artists-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3E1102",
          "image": "./assets/images/coptic-vine-mark.png",
          "imageWidth": 120
        }
      ],
      "expo-font"
    ]
  }
}
